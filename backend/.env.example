# 工器具管理系统 - 环境变量配置（示例）
# 部署时复制为 .env 并修改以下值

# 服务端口
PORT=3000

# JWT 密钥（生产环境必须替换为随机长字符串）
# 生成命令: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-random-64-char-string

# 默认管理员初始密码（仅首次初始化数据库时使用）
DEFAULT_ADMIN_PASSWORD=ChangeMe123!

# 默认普通用户初始密码
DEFAULT_USER_PASSWORD=UserPwd123!

# CORS 允许的源（逗号分隔）
# 生产环境务必包含实际访问域名/IP，否则所有 API 请求会被 CORS 拒绝！
# 示例: CORS_ORIGIN=http://localhost:5173,http://你的服务器IP
CORS_ORIGIN=http://localhost:5173

# 请求体大小限制
BODY_LIMIT=10mb

# 运行环境 (development | production)
NODE_ENV=production

# ===== 微信小程序登录（可选） =====
# 未配置时 POST /api/auth/wx-login 会返回 500，其余功能不受影响
# 在微信公众平台（https://mp.weixin.qq.com）「开发管理-开发设置」中获取 AppID 与 AppSecret
WX_APPID=
WX_SECRET=

# 微信订阅消息模板 ID（在公众平台「功能-订阅消息-我的模板」创建后填入）
# WX_TPL_CLAIM=  领用成功通知（领取物料/工具后推送）
# WX_TPL_REMIND= 工单归还提醒（每天 8:00/20:00 推送未归还工单）
# REMIND_HOURS=8,20  每日提醒触发时刻（小时）
