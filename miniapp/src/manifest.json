{
  "name": "工器具管理",
  "appid": "touristappid",
  "description": "工器具管理系统微信小程序",
  "versionName": "1.0.0",
  "versionCode": "100",
  "transformPx": false,
  "vueVersion": "3",
  "locale": "zh-Hans",
  "h5": {
