# 开发环境：连腾讯云公网服务器上的小程序 API 网关（独立端口 3300）
# 前置条件：
#   1) 后端已部署到 82.156.62.59 并以 HOST=0.0.0.0 PORT=3300 启动
#   2) 服务器安全组/防火墙放行 TCP 3300
#   3) 开发者工具「详情 → 本地设置」勾选「不校验合法域名…」（HTTP+IP 才能联调）
# 仅用于本地开发调试，正式发布需换成 HTTPS 备案域名（见 .env.production）
VITE_API_BASE_URL=http://82.156.62.59:3300/api

# 微信订阅消息模板 ID（公众平台「功能-订阅消息-我的模板」创建后填入，需与后端 .env 的 WX_TPL_* 一致）
VITE_WX_TPL_CLAIM=
VITE_WX_TPL_REMIND=
